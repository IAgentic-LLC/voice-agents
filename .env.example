# Copy to .env and fill in. .env is gitignored; never commit real values.
# Chapters 1 to 14 need only the first line.
GEMINI_API_KEY=

# Chapter 15: a real phone number.
# From LiveKit Cloud, Settings -> Keys, and Settings -> Project:
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# The SIP URI Twilio dials, from LiveKit Cloud project settings:
LIVEKIT_SIP_URI=<your-project>.sip.livekit.cloud

# From the Twilio console home page:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
